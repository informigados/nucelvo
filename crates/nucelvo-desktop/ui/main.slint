import { CheckBox, ComboBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";

import { ActionButton, AuthorCard, ChartPlot, Glyph, ThemeOption } from "visuals.slint";

export struct Row {
    label: string,
    value: string,
    detail: string,
    group: string,
    group-start: bool,
    group-model: string,
    subgroup: string,
    subgroup-start: bool,
    note: string,
    copyable: bool,
    warning: bool,
}

export struct LiveMetric {
    title: string,
    value: string,
    detail: string,
    key: string,
    tone: int,
    glyph: int,
    available: bool,
}

component MetricTile inherits Rectangle {
    in property <LiveMetric> metric;
    in property <color> accent;
    in property <color> ink;
    in property <color> muted;
    in property <color> hover;
    in property <bool> show-detail: true;
    in property <bool> compact;
    callback activated();
    min-width: 0px;
    preferred-width: 120px;
    horizontal-stretch: 1;
    height: root.show-detail ? 80px : 64px;
    border-radius: 5px;
    background: touch.has-hover || keyboard.has-focus ? root.hover : transparent;
    accessible-role: button;
    accessible-enabled: root.metric.key != "";
    accessible-label: root.metric.title + " · " + root.metric.value + (root.metric.detail == "" ? "" : " · " + root.metric.detail);
    accessible-action-default => { if (root.metric.key != "") { root.activated(); } }
    forward-focus: keyboard;
    VerticalLayout {
        padding: root.compact ? 6px : 8px;
        spacing: 3px;
        alignment: center;
        HorizontalLayout {
            spacing: root.compact ? 5px : 7px;
            Glyph {
                symbol: root.metric.glyph;
                ink: root.accent;
                width: root.compact ? 13px : 15px;
                height: self.width;
            }
            Text { text: root.metric.title; color: root.ink; font-size: root.compact ? 12px : 13px; font-weight: 600; overflow: elide; accessible-role: none; }
        }
        Text {
            text: root.metric.value;
            color: root.metric.available ? root.accent : root.muted;
            font-size: root.metric.available ? (root.compact ? 18px : 22px) : 15px;
            font-weight: 700;
            height: 28px;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        if root.show-detail : Text { text: root.metric.detail; height: 14px; color: root.muted; font-size: 11px; overflow: elide; accessible-role: none; }
    }
    keyboard := FocusScope {
        enabled: root.metric.key != "";
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.metric.key != "";
        mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.activated(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <color> accent;
    in property <color> selection;
    in property <int> glyph;
    in property <bool> compact;
    callback activated();
    height: 34px;
    border-radius: 6px;
    border-width: keyboard.has-focus ? 1px : 0px;
    border-color: root.accent;
    background: active || mouse.has-hover ? selection : transparent;
    in property <color> ink;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    forward-focus: keyboard;
    keyboard := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    if root.active : Rectangle {
        x: 0px;
        width: 3px;
        height: 18px;
        border-radius: 2px;
        background: root.accent;
    }
    Glyph {
        x: root.compact ? (parent.width - self.width) / 2 : 11px;
        y: (parent.height - self.height) / 2;
        symbol: root.glyph;
        ink: root.active ? root.accent : root.ink;
    }
    if !root.compact : Text {
        x: 39px;
        width: parent.width - 47px;
        height: parent.height;
        text: root.label;
        color: root.active ? root.accent : root.ink;
        font-size: 13px;
        font-weight: root.active ? 700 : 500;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    mouse := TouchArea {
        clicked => { keyboard.focus(); root.activated(); }
    }
    Tooltip { text: @markdown("\{root.label}"); }
}

export component MainWindow inherits Window {
    title: "Nucelvo";
    icon: @image-url("../../../assets/brand/nucelvo-icon.svg");
    preferred-width: 1050px;
    preferred-height: 690px;
    min-width: 680px;
    min-height: 480px;
    default-font-size: 14px;

    in property <bool> portuguese;
    in property <bool> save-failed;
    in property <int> page;
    in property <bool> ready;
    in property <bool> refreshing;
    in property <bool> paused;
    in property <string> capture-time;
    in property <[Row]> rows;
    in property <[string]> metric-options;
    in property <int> metric-index: -1;
    in property <string> current-value: "—";
    in property <[LiveMetric]> live-metrics;
    in property <string> live-device;
    in property <int> sensor-group;
    in property <int> metric-tone;
    in-out property <string> metric-search-text;
    in property <string> low-value: "—";
    in property <string> high-value: "—";
    in property <string> average-value: "—";
    in property <string> metric-detail;
    in property <string> graph;
    in property <string> graph-area;
    in property <int> metric-icon: 9;
    in property <bool> inline-chart-available;
    in property <bool> inline-chart-open;
    in-out property <int> expanded-note: -1;
    in property <[string]> storage-options;
    in property <int> storage-index;
    in property <string> axis-low;
    in property <string> axis-high;
    in property <bool> has-graph;
    in property <int> range-index;
    in property <[Row]> preview;
    in property <int> preview-count;
    in property <int> preview-page;
    in property <bool> export-busy;
    in property <bool> export-prepared;
    in property <int> export-default-scope;
    in-out property <int> export-category;
    in-out property <bool> share-safe-category: true;
    in property <bool> folder-ready;
    in property <int> notice;
    in property <string> notice-detail;
    in property <string> app-version;
    in property <string> copyright-year;
    in property <int> update-state;
    in property <int> update-download-state;
    in property <bool> update-installable;
    in property <string> update-version;
    in property <bool> about-link-failed;
    out property <string> about-title: @tr("About");

    out property <string> overview-title: @tr("Overview");
    private property <[string]> inventory-tabs: [
        @tr("Overview"), "CPU", @tr("Memory"), @tr("Motherboard"),
        @tr("Graphics"), @tr("Storage"), @tr("System"), @tr("Sensors"), @tr("Export"), root.about-title
    ];
    private property <[int]> tab-icons: [0, 1, 2, 3, 4, 5, 6, 7, 8, 13];
    private property <[string]> times: [@tr("Last minute"), @tr("Last 5 minutes"), @tr("Last 15 minutes")];
    private property <[string]> sensor-groups: [@tr("All sensors"), "CPU", @tr("Memory"), @tr("Graphics"), @tr("Temperature"), @tr("Network"), @tr("Frequencies")];
    private property <[string]> export-scopes: [@tr("Full inventory"), @tr("One category"), @tr("Current sensor readings"), @tr("Sensor history · 5 minutes"), @tr("Sensor history · 15 minutes")];
    in property <bool> narrow;
    out property <bool> dark-mode: Palette.color-scheme == ColorScheme.dark;
    private property <bool> dark: root.dark-mode;
    public function apply-theme(choice: int) {
        Palette.color-scheme = choice == 2 ? ColorScheme.dark : ColorScheme.light;
    }
    private property <color> ink: dark ? #edf6f2 : #192e28;
    private property <color> muted: dark ? #a9c1b8 : #456159;
    private property <color> line: dark ? #344941 : #c6d8d0;
    private property <color> surface: dark ? #14221f : #f7faf8;
    private property <color> rail: dark ? #182923 : #edf5f0;
    private property <color> raised: dark ? #1a3029 : #e7f3ec;
    private property <color> accent: dark ? #86e9c4 : #08604e;
    private property <[color]> metric-colors: [accent, dark ? #9acbfd : #244f91, dark ? #cbb7ff : #603b9b, dark ? #ffc589 : #935019,
        dark ? #74ddd0 : #08746b, dark ? #aabfff : #3c50a0];
    background: surface;

    callback navigate(int);
    callback language-selected(int);
    callback theme-selected(int);
    callback refresh();
    callback search(string);
    callback storage-selected(int);
    callback copy(string);
    callback pause();
    callback metric(int);
    callback range-changed(int);
    callback metric-filter(string);
    callback sensor-group-changed(int);
    callback open-sensor(string);
    callback prepare-export(int, int, bool, int);
    callback invalidate-export();
    callback save-export();
    callback change-preview-page(int);
    callback open-folder();
    callback check-updates();
    callback download-update();
    callback install-update();
    callback about-link(int);

    FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "f" || event.text == "F") && root.page < 8) {
                if (root.page == 7) { metric-search.focus(); }
                else { field-search.focus(); }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            Rectangle {
                height: 64px;
                background: root.rail;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 12px;
                    VerticalLayout {
                        width: 171px;
                        alignment: center;
                        Image {
                            source: root.dark ? @image-url("../../../assets/brand/nucelvo-logo-dark.svg")
                                              : @image-url("../../../assets/brand/nucelvo-logo-light.svg");
                            image-fit: contain;
                            height: 38px;
                            accessible-label: "Nucelvo";
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                width: 18px;
                                alignment: center;
                                Image {
                                    width: 18px;
                                    height: 18px;
                                    source: @image-url("icons/globe.svg");
                                    colorize: root.muted;
                                    accessible-role: none;
                                }
                            }
                            ComboBox {
                                width: 170px;
                                height: 34px;
                                accessible-label: @tr("Language");
                                model: ["English", "Português (Brasil)"];
                                current-index: root.portuguese ? 1 : 0;
                                selected(_) => { root.language-selected(self.current-index); }
                            }
                            Rectangle {
                                width: 80px;
                                height: 34px;
                                border-radius: 6px;
                                background: root.surface;
                                border-width: 1px;
                                border-color: root.line;
                                HorizontalLayout {
                                    padding: 3px;
                                    spacing: 2px;
                                    ThemeOption {
                                        label: @tr("Light theme");
                                        icon: @image-url("icons/sun.svg");
                                        ink: root.muted;
                                        accent: root.accent;
                                        selection: root.raised;
                                        checked: !root.dark;
                                        clicked => { root.theme-selected(1); }
                                    }
                                    ThemeOption {
                                        label: @tr("Dark theme");
                                        icon: @image-url("icons/moon.svg");
                                        ink: root.muted;
                                        accent: root.accent;
                                        selection: root.raised;
                                        checked: root.dark;
                                        clicked => { root.theme-selected(2); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: root.line; }
            HorizontalLayout {
                spacing: 0px;
                Rectangle {
                    width: root.narrow ? 55px : 174px;
                    background: root.rail;
                    VerticalLayout {
                        padding: root.narrow ? 7px : 12px;
                        spacing: 4px;
                        alignment: start;
                        for title[index] in root.inventory-tabs : NavItem {
                            label: title;
                            glyph: root.tab-icons[index];
                            compact: root.narrow;
                            active: index == root.page;
                            accent: root.accent;
                            selection: root.raised;
                            ink: root.ink;
                            activated => { root.navigate(index); }
                        }
                    }
                    Rectangle { x: parent.width - 1px; width: 1px; background: root.line; }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        min-height: 40px;
                        Text {
                            text: root.inventory-tabs[root.page];
                            color: root.ink;
                            font-size: 28px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if root.page < 7 : ActionButton {
                            icon: @image-url("icons/refresh.svg");
                            text: root.refreshing ? @tr("Refreshing…") : @tr("Refresh inventory");
                            enabled: !root.refreshing;
                            clicked => { root.refresh(); }
                        }
                        if root.page == 7 : ActionButton {
                            icon: root.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                            text: root.paused ? @tr("Resume") : @tr("Pause");
                            clicked => { root.pause(); }
                        }
                        if root.inline-chart-available : ActionButton {
                            icon: @image-url("icons/chart.svg");
                            text: root.inline-chart-open ? @tr("Hide chart") : @tr("Show chart");
                            clicked => { root.open-sensor(""); }
                        }
                        if root.page < 8 : ActionButton {
                            icon: @image-url("icons/export.svg");
                            text: @tr("Export");
                            clicked => { root.navigate(8); }
                        }
                    }

                    if root.page != 9 && (root.notice != 0 || root.save-failed) : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                            color: root.ink;
                            text: root.save-failed ? @tr("Could not save preferences.") :
                                root.notice == 1 ? @tr("Copied to clipboard.") :
                                root.notice == 2 ? @tr("Could not access the clipboard.") :
                                root.notice == 3 ? @tr("Report saved · {}", root.notice-detail) :
                                root.notice == 4 ? @tr("That file already exists. Choose another name.") :
                                root.notice == 5 ? @tr("Could not save the report. Choose another location or try again.") :
                                root.notice == 6 ? @tr("No data is available for this export.") :
                                root.notice == 7 ? @tr("Could not open the folder.") :
                                root.notice == 9 ? @tr("You don't have permission to save here. Choose another folder.") :
                                root.notice == 10 ? @tr("There isn't enough free space to save the report.") :
                                root.notice == 11 ? @tr("The destination folder is unavailable. Choose another folder.") :
                                @tr("Saving canceled.");
                        }
                        if root.folder-ready : ActionButton {
                            icon: @image-url("icons/folder.svg");
                            text: @tr("Open folder");
                            clicked => { root.open-folder(); }
                        }
                    }

                    VerticalLayout {
                        visible: root.page < 7;
                        height: root.page < 7 ? self.preferred-height : 0px;
                        spacing: 10px;
                        if (root.page == 0 || root.page == 1 || root.page == 2 || root.page == 4 || root.page == 6) && root.live-metrics.length > 0
                           && (!root.inline-chart-open || root.height >= 680px) : VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.paused ? @tr("Monitoring paused") : root.page == 6 ? @tr("Live network traffic") : @tr("Live readings");
                                    color: root.ink;
                                    font-weight: 650;
                                    vertical-alignment: center;
                                }
                                if root.page == 0 : ActionButton {
                                    icon: @image-url("icons/sensors.svg");
                                    text: @tr("Sensors");
                                    clicked => { root.navigate(7); }
                                }
                                if root.page == 4 : Text {
                                    text: root.live-device;
                                    color: root.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            if root.page == 6 : Text {
                                text: @tr("Combined traffic across connected Ethernet and Wi-Fi adapters.");
                                color: root.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Rectangle { height: 1px; background: root.line; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: root.live-metrics.length == 1 ? start : stretch;
                                for metric in root.live-metrics : MetricTile {
                                    metric: metric;
                                    accent: root.metric-colors[metric.tone];
                                    ink: root.ink;
                                    muted: root.muted;
                                    hover: root.raised;
                                    show-detail: root.page != 4 && root.page != 6;
                                    compact: root.narrow && root.page == 4;
                                    activated => { root.open-sensor(metric.key); }
                                }
                            }
                            Rectangle { height: 1px; background: root.line; }
                        }
                        if root.inline-chart-open : VerticalLayout {
                            spacing: 7px;
                            HorizontalLayout {
                                spacing: 8px;
                                ComboBox {
                                    accessible-label: @tr("Sensor");
                                    horizontal-stretch: 1;
                                    model: root.metric-options;
                                    current-index: root.metric-index;
                                    enabled: root.metric-options.length > 0;
                                    selected(_) => { root.metric(self.current-index); }
                                }
                                ComboBox {
                                    width: 146px;
                                    accessible-label: @tr("History range");
                                    model: root.times;
                                    current-index: root.range-index;
                                    selected(_) => { root.range-changed(self.current-index); }
                                }
                            }
                            ChartPlot {
                                height: root.narrow ? 102px : 130px;
                                curve: root.graph; area: root.graph-area;
                                upper: root.axis-high; lower: root.axis-low;
                                accent: root.metric-colors[root.metric-tone];
                                ink: root.muted; grid: root.line;
                                has-data: root.has-graph;
                                empty-message: @tr("Waiting for readings…");
                            }
                            HorizontalLayout {
                                spacing: 7px;
                                Glyph { symbol: root.metric-icon; ink: root.metric-colors[root.metric-tone]; width: 14px; height: 14px; }
                                Text { text: root.current-value; color: root.ink; font-size: 12px; }
                                Text { text: root.metric-detail; color: root.muted; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            if root.page == 5 : ComboBox {
                                width: root.narrow ? 210px : 270px;
                                accessible-label: @tr("Storage device");
                                model: root.storage-options;
                                current-index: root.storage-index;
                                selected(_) => { root.storage-selected(self.current-index); }
                            }
                            field-search := LineEdit {
                                placeholder-text: @tr("Search inventory");
                                accessible-label: @tr("Search inventory");
                                edited(value) => { root.search(value); }
                            }
                            Text {
                                text: root.capture-time;
                                color: root.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        if root.page == 5 : Text {
                            text: @tr("Drive health reflects the last inventory capture. SSD wear is a manufacturer estimate.");
                            color: root.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    if root.page < 7 : VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 6px;
                        if root.rows.length == 0 : Text {
                            color: root.muted;
                            wrap: word-wrap;
                            text: root.refreshing ? @tr("Collecting inventory…") : @tr("No matching fields.");
                        }
                        ListView {
                            content-width: self.visible-width;
                            for item[index] in root.rows : entry := Rectangle {
                                private property <length> header-height: (item.group-start ? 35px : 0px) + (item.subgroup-start ? 29px : 0px);
                                private property <bool> note-open: root.expanded-note == index && item.note != "";
                                height: header-height + 58px + (note-open ? 60px : 0px);
                                Rectangle { y: parent.height - 1px; height: 1px; background: root.line; }
                                if item.group-start : HorizontalLayout {
                                    y: 0px;
                                    height: 35px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Text {
                                        text: item.group;
                                        color: root.accent;
                                        font-size: 14px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    if item.group-model != "" : ActionButton {
                                        icon: @image-url("icons/copy.svg");
                                        text: @tr("Copy model");
                                        clicked => { root.copy(item.group-model); }
                                    }
                                }
                                if item.subgroup-start : Rectangle {
                                    y: item.group-start ? 35px : 0px;
                                    height: 29px;
                                    background: root.rail;
                                    Text {
                                        x: 16px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: item.subgroup;
                                        color: root.ink;
                                        font-size: 12px;
                                        font-weight: 650;
                                        vertical-alignment: center;
                                    }
                                }
                                HorizontalLayout {
                                    y: entry.header-height;
                                    height: 58px;
                                    spacing: 12px;
                                    padding-left: item.subgroup == "" ? 8px : 16px;
                                    padding-right: 8px;
                                    VerticalLayout {
                                        width: root.narrow ? 146px : 182px;
                                        alignment: center;
                                        spacing: 3px;
                                        Text { text: item.label; color: root.ink; font-weight: 600; wrap: word-wrap; }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 3px;
                                        Text {
                                            text: item.value;
                                            color: item.warning ? root.metric-colors[3] : root.ink;
                                            font-weight: item.warning ? 650 : 400;
                                            wrap: word-wrap;
                                        }
                                        Text { text: item.detail; color: root.muted; font-size: 11px; overflow: elide; }
                                    }
                                    if item.note != "" : VerticalLayout {
                                        alignment: center;
                                        ActionButton {
                                            icon: @image-url("icons/help.svg");
                                            checked: entry.note-open;
                                            accessible-checkable: true;
                                            accessible-label: @tr("About {}", item.label);
                                            clicked => { root.expanded-note = root.expanded-note == index ? -1 : index; }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ActionButton {
                                            icon: @image-url("icons/copy.svg");
                                            text: @tr("Copy");
                                            accessible-label: @tr("Copy {}", item.label);
                                            enabled: item.copyable;
                                            clicked => { root.copy(item.value); }
                                        }
                                    }
                                }
                                if entry.note-open : Rectangle {
                                    y: entry.header-height + 58px;
                                    height: 54px;
                                    background: root.raised;
                                    border-radius: 5px;
                                    Text {
                                        x: 12px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: item.note;
                                        color: root.ink;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        visible: root.page == 7;
                        height: root.page == 7 ? self.preferred-height : 0px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            metric-search := LineEdit {
                                placeholder-text: @tr("Filter sensors");
                                accessible-label: @tr("Filter sensors");
                                text <=> root.metric-search-text;
                                edited(value) => { root.metric-filter(value); }
                            }
                            ComboBox {
                                width: 144px;
                                accessible-label: @tr("Sensor group");
                                model: root.sensor-groups;
                                current-index: root.sensor-group;
                                selected(_) => { root.sensor-group-changed(self.current-index); }
                            }
                            ComboBox {
                                width: 156px;
                                accessible-label: @tr("History range");
                                model: root.times;
                                current-index: root.range-index;
                                selected(_) => { root.range-changed(self.current-index); }
                            }
                        }
                        ComboBox {
                            accessible-label: @tr("Sensor");
                            model: root.metric-options;
                            current-index: root.metric-index;
                            enabled: root.metric-options.length > 0;
                            selected(_) => { root.metric(self.current-index); }
                        }
                    }

                    if root.page == 7 : ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, 315px);
                        VerticalLayout {
                            alignment: start;
                            padding-right: 8px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                for stat[index] in [@tr("Current"), @tr("Session minimum"), @tr("Session maximum"), @tr("Session average")] : Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    preferred-width: 120px;
                                    height: 68px;
                                    border-radius: 6px;
                                    background: root.raised;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 3px;
                                        alignment: center;
                                        Text { text: stat; color: root.muted; font-size: 12px; overflow: elide; }
                                        Text {
                                            color: index == 0 ? root.metric-colors[root.metric-tone] : root.ink;
                                            font-weight: 650;
                                            font-size: 19px;
                                            overflow: elide;
                                            text: index == 0 ? root.current-value : index == 1 ? root.low-value : index == 2 ? root.high-value : root.average-value;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 7px;
                                Glyph { symbol: root.metric-icon; ink: root.metric-colors[root.metric-tone]; width: 14px; height: 14px; }
                                Text { text: root.metric-detail; color: root.muted; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                            ChartPlot {
                                height: 167px;
                                curve: root.graph;
                                area: root.graph-area;
                                upper: root.axis-high;
                                lower: root.axis-low;
                                accent: root.metric-colors[root.metric-tone];
                                ink: root.muted;
                                grid: root.line;
                                has-data: root.has-graph;
                                empty-message: root.metric-options.length == 0 ? @tr("No matching sensors.") : @tr("Waiting for readings…");
                            }
                            HorizontalLayout {
                                Text { text: root.times[root.range-index]; color: root.muted; font-size: 12px; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: @tr("Gaps indicate missing samples"); color: root.muted; font-size: 12px; }
                            }
                        }
                    }

                    if root.page == 9 : ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, 436px);
                        VerticalLayout {
                            alignment: start;
                            padding-right: 8px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 14px;
                                Image {
                                    source: @image-url("../../../assets/brand/nucelvo-icon.svg");
                                    width: 52px;
                                    height: 52px;
                                    image-fit: contain;
                                    accessible-role: none;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: "Nucelvo"; color: root.ink; font-size: 24px; font-weight: 700; }
                                    Text { text: @tr("Version {}", root.app-version); color: root.muted; font-size: 12px; }
                                }
                            }
                            Text {
                                text: @tr("Hardware inventory, live sensor monitoring, and diagnostic reports for Windows and Linux.");
                                color: root.muted;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ActionButton {
                                    icon: @image-url("icons/refresh.svg");
                                    text: root.update-state == 1 ? @tr("Checking for updates…") : @tr("Check for updates");
                                    enabled: root.update-state != 1 && root.update-download-state != 1 && root.update-download-state != 3;
                                    clicked => { root.check-updates(); }
                                }
                                if root.update-state == 3 : ActionButton {
                                    icon: @image-url("icons/external.svg");
                                    text: @tr("View release on GitHub");
                                    clicked => { root.about-link(4); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.update-state >= 2 : Text {
                                color: root.update-state == 4 ? root.metric-colors[3] : root.muted;
                                wrap: word-wrap;
                                text: root.update-state == 2 ? @tr("No newer version was found.") :
                                    root.update-state == 3 ? @tr("Version {} is available.", root.update-version) :
                                    @tr("Could not check for updates. Check your connection and try again.");
                            }
                            if root.update-installable : VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    if root.update-download-state == 0 || root.update-download-state == 4 : ActionButton {
                                        icon: @image-url("icons/refresh.svg");
                                        text: @tr("Update now");
                                        clicked => { root.download-update(); }
                                    }
                                    if root.update-download-state == 2 : ActionButton {
                                        icon: @image-url("icons/refresh.svg");
                                        text: @tr("Install update and close Nucelvo");
                                        enabled: !root.export-busy;
                                        clicked => { root.install-update(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if root.update-download-state > 0 : Text {
                                    color: root.update-download-state == 4 ? root.metric-colors[3] : root.muted;
                                    wrap: word-wrap;
                                    text: root.update-download-state == 1 ? @tr("Downloading and verifying the installer…") :
                                        root.update-download-state == 2 ? @tr("The installer matches the SHA-256 published by GitHub.") :
                                        root.update-download-state == 3 ? @tr("Waiting for Windows to open the installer…") :
                                        @tr("The update could not be downloaded, verified, or opened. You can retry or visit GitHub.");
                                }
                            }
                            Rectangle { height: 1px; background: root.line; }
                            Text { text: @tr("Authors"); color: root.ink; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 10px;
                                AuthorCard {
                                    horizontal-stretch: 1;
                                    name: "INformigados"; handle: "@informigados";
                                    avatar: @image-url("../../../assets/authors/informigados.webp");
                                    ink: root.ink; muted: root.muted; line: root.line;
                                    clicked => { root.about-link(0); }
                                }
                                AuthorCard {
                                    horizontal-stretch: 1;
                                    name: "Alex Brito"; handle: "@alexbritodev";
                                    avatar: @image-url("../../../assets/authors/alex-brito-dev.webp");
                                    ink: root.ink; muted: root.muted; line: root.line;
                                    clicked => { root.about-link(1); }
                                }
                            }
                            Rectangle { height: 1px; background: root.line; }
                            Text {
                                text: root.copyright-year + " © Nucelvo · " + @tr("All rights reserved.");
                                color: root.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                ActionButton {
                                    icon: @image-url("icons/external.svg");
                                    text: @tr("Designed by INformigados");
                                    clicked => { root.about-link(2); }
                                }
                                ActionButton {
                                    icon: @image-url("icons/external.svg");
                                    text: @tr("View repository");
                                    clicked => { root.about-link(3); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.about-link-failed : Text {
                                text: @tr("Could not open the link in your browser.");
                                color: root.metric-colors[3];
                                wrap: word-wrap;
                            }
                        }
                    }

                    if root.page == 8 : VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            scope-box := ComboBox {
                                model: root.export-scopes;
                                current-index: root.export-default-scope;
                                accessible-label: @tr("Export scope");
                                selected(_) => { root.share-safe-category = true; root.invalidate-export(); }
                            }
                            format-box := ComboBox {
                                model: ["JSON", "TXT", "CSV", "HTML"];
                                current-index: 0;
                                width: 160px;
                                accessible-label: @tr("File format");
                                selected(_) => { root.invalidate-export(); }
                            }
                        }
                        if scope-box.current-index == 1 : ComboBox {
                            model: ["CPU", @tr("Memory"), @tr("Motherboard"), @tr("Graphics"), @tr("Storage"), @tr("System")];
                            current-index: root.export-category;
                            accessible-label: @tr("Category");
                            selected(_) => {
                                root.export-category = self.current-index;
                                root.share-safe-category = true;
                                root.invalidate-export();
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            if scope-box.current-index == 1 : CheckBox {
                                text: @tr("Share-safe");
                                checked: root.share-safe-category;
                                toggled => { root.share-safe-category = self.checked; root.invalidate-export(); }
                            }
                            if scope-box.current-index != 1 : Text {
                                text: @tr("Share-safe");
                                color: root.accent;
                                font-weight: 650;
                            }
                            Text {
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                                color: root.muted;
                                text: scope-box.current-index != 1 || root.share-safe-category ? @tr("Hides serial numbers, volume names, and volume paths.") : @tr("This report may include identifiers. Review it before sharing.");
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ActionButton {
                                icon: @image-url("icons/preview.svg");
                                text: @tr("Preview report");
                                enabled: !root.export-busy && (scope-box.current-index >= 2 || root.ready);
                                clicked => { root.prepare-export(scope-box.current-index, format-box.current-index, root.share-safe-category, root.export-category); }
                            }
                            ActionButton {
                                icon: @image-url("icons/save.svg");
                                text: root.export-busy ? @tr("Saving…") : @tr("Save report…");
                                primary: true;
                                enabled: root.export-prepared && !root.export-busy;
                                clicked => { root.save-export(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text {
                            color: root.muted;
                            wrap: word-wrap;
                            text: root.export-prepared ? (root.preview-count == 1 ? @tr("1 row · page {}", root.preview-page + 1) : @tr("{} rows · page {}", root.preview-count, root.preview-page + 1)) :
                                @tr("Preview the report to review what will be saved.");
                        }
                        ListView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            for entry in root.preview : Rectangle {
                                height: 42px;
                                Rectangle { y: parent.height - 1px; height: 1px; background: root.line; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: entry.label; vertical-alignment: center; color: root.muted; width: 45%; overflow: elide; }
                                    Text { text: entry.value; vertical-alignment: center; color: root.ink; wrap: word-wrap; }
                                }
                            }
                        }
                        if root.preview-count > 100 : HorizontalLayout {
                            spacing: 8px;
                            ActionButton { icon: @image-url("icons/previous.svg"); text: @tr("Previous"); enabled: root.preview-page > 0; clicked => { root.change-preview-page(-1); } }
                            ActionButton { icon: @image-url("icons/next.svg"); text: @tr("Next"); enabled: (root.preview-page + 1) * 100 < root.preview-count; clicked => { root.change-preview-page(1); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }
    }
}
