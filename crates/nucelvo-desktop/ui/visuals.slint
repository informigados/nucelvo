import { Button } from "std-widgets.slint";

export component ActionButton inherits Button {
    icon-size: 16px;
    colorize-icon: true;
}

export component ThemeOption inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> checked;
    in property <color> ink;
    in property <color> accent;
    in property <color> selection;
    callback clicked();
    width: 36px;
    height: 28px;
    border-radius: 4px;
    border-width: keyboard.has-focus || root.checked ? 1px : 0px;
    border-color: keyboard.has-focus ? root.accent : root.accent.with-alpha(0.46);
    background: root.checked ? root.selection : mouse.has-hover ? root.accent.with-alpha(0.10) : transparent;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    forward-focus: keyboard;
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 17px;
        source: root.icon;
        colorize: root.checked ? root.accent : root.ink;
        accessible-role: none;
    }
    keyboard := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    mouse := TouchArea {
        mouse-cursor: pointer;
        clicked => { keyboard.focus(); root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.label}"); }
}

export component Glyph inherits Path {
    in property <int> symbol;
    in property <color> ink;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.ink;
    stroke-width: 1.45px;
    stroke-line-cap: round;
    fill: transparent;
    commands: symbol == 0 ? "M3 3 H10 V10 H3 Z M14 3 H21 V10 H14 Z M3 14 H10 V21 H3 Z M14 14 H21 V21 H14 Z"
        : symbol == 1 ? "M6 6 H18 V18 H6 Z M9 9 H15 V15 H9 Z M9 3 V6 M15 3 V6 M9 18 V21 M15 18 V21 M3 9 H6 M3 15 H6 M18 9 H21 M18 15 H21"
        : symbol == 2 ? "M3 7 H21 V16 H3 Z M7 10 V13 M12 10 V13 M17 10 V13 M6 16 V19 M10 16 V19 M14 16 V19 M18 16 V19"
        : symbol == 3 ? "M4 3 H20 V21 H4 Z M7 6 H12 V11 H7 Z M15 6 V10 H17 M7 15 H12 M7 18 H12 M15 13 H17 V18 H15 Z"
        : symbol == 4 ? "M3 5 H21 V17 H3 Z M8 21 H16 M12 17 V21 M7 14 L13 8 M12 14 L16 10"
        : symbol == 5 ? "M5 4 H19 L22 13 V19 H2 V13 Z M2 13 H22 M6 16 H8 M11 16 H13"
        : symbol == 6 ? "M4 4 H20 V20 H4 Z M12 11 V16 M12 8 V8.1"
        : symbol == 7 ? "M2 13 H6 L9 6 L13 18 L16 10 L18 13 H22"
        : symbol == 8 ? "M5 3 H14 L19 8 V14 M5 3 V21 H15 M14 3 V8 H19 M13 17 H22 M18 13 L22 17 L18 21"
        : symbol == 10 ? "M10 14 V5 A2 2 0 0 1 14 5 V14 A4 4 0 1 1 10 14 Z M12 9 V17 M17 6 H20 M17 10 H19"
        : symbol == 11 ? "M12 10 C8 10 7 4 11 3 C14 3 14 7 13 10 M14 12 C15 8 21 9 21 13 C20 16 16 15 14 13 M11 14 C14 17 10 22 7 20 C5 18 8 15 10 13 M14 12 A2 2 0 1 1 10 12 A2 2 0 1 1 14 12"
        : symbol == 12 ? "M13 2 L5 13 H11 L10 22 L19 10 H13 Z"
        : symbol == 13 ? "M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 M12 11 V16 M12 8 V8.1"
        : symbol == 14 ? "M12 4 V16 M7 11 L12 16 L17 11 M5 20 H19"
        : symbol == 15 ? "M12 16 V4 M7 9 L12 4 L17 9 M5 20 H19"
        : "M4 19 V13 H7 V19 M10 19 V9 H13 V19 M16 19 V5 H19 V19 M3 19 H21";
    accessible-role: none;
}

export component AuthorCard inherits Rectangle {
    in property <string> name;
    in property <string> handle;
    in property <image> avatar;
    in property <color> ink;
    in property <color> muted;
    in property <color> line;
    callback clicked();
    min-width: 0px;
    height: 80px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.line;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            width: 48px;
            alignment: center;
            Rectangle {
                height: 48px;
                clip: true;
                border-radius: 9px;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.avatar;
                    image-fit: cover;
                    accessible-role: none;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: root.name; color: root.ink; font-weight: 700; overflow: elide; }
            Text { text: root.handle; color: root.muted; font-size: 12px; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            width: 38px;
            ActionButton {
                icon: @image-url("icons/external.svg");
                accessible-label: root.name + " · GitHub";
                clicked => { root.clicked(); }
            }
        }
    }
}

export component ChartPlot inherits Rectangle {
    in property <string> curve;
    in property <string> area;
    in property <string> upper;
    in property <string> lower;
    in property <string> empty-message;
    in property <color> accent;
    in property <color> ink;
    in property <color> grid;
    in property <bool> has-data;
    border-width: 1px;
    border-radius: 6px;
    border-color: root.grid;
    clip: true;
    HorizontalLayout {
        padding: 10px;
        spacing: 8px;
        VerticalLayout {
            width: 70px;
            Text { text: root.upper; color: root.ink; font-size: 11px; horizontal-alignment: right; }
            Rectangle { vertical-stretch: 1; }
            Text { text: root.lower; color: root.ink; font-size: 11px; horizontal-alignment: right; }
        }
        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            for mark in [0.0, 0.25, 0.5, 0.75, 1.0] : Rectangle {
                y: (parent.height - 1px) * mark;
                height: 1px;
                background: root.grid;
            }
            for mark in [0.0, 0.1667, 0.3333, 0.5, 0.6667, 0.8333, 1.0] : Rectangle {
                x: (parent.width - 1px) * mark;
                width: 1px;
                background: root.grid;
            }
            if root.has-data : Path {
                width: parent.width;
                height: parent.height;
                commands: root.area;
                fill: root.accent.with-alpha(0.14);
                fit: fill;
                viewbox-width: 1000;
                viewbox-height: 100;
            }
            if root.has-data : Path {
                width: parent.width;
                height: parent.height;
                commands: root.curve;
                stroke: root.accent;
                stroke-width: 1.6px;
                stroke-line-cap: round;
                fill: transparent;
                fit: fill;
                viewbox-width: 1000;
                viewbox-height: 100;
            }
            if !root.has-data : Text {
                width: parent.width;
                height: parent.height;
                text: root.empty-message;
                color: root.ink;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
