1 ICON NUCELVO_ICON

1 VERSIONINFO
 FILEVERSION NUCELVO_MAJOR,NUCELVO_MINOR,NUCELVO_PATCH,0
 PRODUCTVERSION NUCELVO_MAJOR,NUCELVO_MINOR,NUCELVO_PATCH,0
 FILEOS 0x00040004L
 FILETYPE 0x00000001L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "INformigados"
            VALUE "FileDescription", "Nucelvo"
            VALUE "FileVersion", NUCELVO_VERSION
            VALUE "InternalName", "nucelvo"
            VALUE "OriginalFilename", "nucelvo.exe"
            VALUE "ProductName", "Nucelvo"
            VALUE "ProductVersion", NUCELVO_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
